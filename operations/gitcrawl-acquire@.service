[Unit]
Description=Acquire PostgreSQL-owned GitHub source %i through Octopool
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=gitcrawl
Group=gitcrawl
WorkingDirectory=/var/lib/gitcrawl/%i
EnvironmentFile=/etc/gitcrawl/acquire-%i.env
EnvironmentFile=/etc/gitcrawl/provider-%i.env
ExecStartPre=/usr/bin/test -s /etc/gitcrawl/acquire-%i.toml
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code=75 /var/lib/gitcrawl/%i/acquire.lock /usr/local/bin/gitcrawl --config /etc/gitcrawl/acquire-%i.toml acquire-api --endpoint ${GITCRAWL_ORIGIN} --source ${GITCRAWL_ARCHIVE} --repo ${GITCRAWL_REPOSITORY} --publisher-token-env GITCRAWL_PUBLISHER_TOKEN --reader-token-env GITCRAWL_READER_TOKEN --max-threads 100 --parent-page-size 100 --child-page-size 20 --timeout 180s --json
TimeoutStartSec=4min
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/gitcrawl/%i
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
CPUQuota=100%
StandardOutput=journal
StandardError=journal
